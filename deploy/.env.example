# Copy to .env and fill in. docker-compose reads this automatically.

# Domain pointing at this server — Caddy fetches a Let's Encrypt cert for it.
MASTER_DOMAIN=master.example.com

# Public HTTPS base URL used to render agent install commands on the panel.
MASTER_BASE_URL=https://master.example.com

# Password for logging into the web panel.
MASTER_ADMIN_PASSWORD=change-me
